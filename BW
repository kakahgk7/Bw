local op = false
local dg = false
local mv = false
local sm2 = nil
local sp2 = il.Position

il.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dg = true
        mv = false
        sm2 = i.Position
        sp2 = il.Position
    end
end)

U.InputChanged:Connect(function(i)
    if dg and sm2 then
        local d = i.Position - sm2
        if d.Magnitude > 6 then mv = true end
        il.Position = UDim2.new(
            sp2.X.Scale, sp2.X.Offset + d.X,
            sp2.Y.Scale, sp2.Y.Offset + d.Y
        )
    end
end)

