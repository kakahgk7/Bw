                    b2.Enabled = true
                    b2.Parent = c
                    local t = Instance.new("TextLabel")
                    t.Size = UDim2.new(1, 0, 1, 0)
                    t.BackgroundTransparency = 1
                    t.Text = p.DisplayName
                    t.TextColor3 = Color3.fromRGB(255, 0, 0)
                    t.Font = Enum.Font.SourceSansBold
                    t.TextSize = 14
                    t.Parent = b2
                end
            end
            if p.Character then f() end
        end
    end
end

local function bu()
