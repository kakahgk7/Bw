local function showMenu(frame, h)
    frame.Visible = true
    frame.Size = UDim2.new(0, 105, 0, 0)
    TS:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 105, 0, h)
    }):Play()
end

local function hideMenu(frame, h)
    frame.Size = UDim2.new(0, 105, 0, h)
    local tw = TS:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 105, 0, 0)
    })
    tw:Play()
    task.delay(0.2, function()
        if frame and frame.Parent then
            frame.Visible = false
            frame.Size = UDim2.new(0, 105, 0, h)
        end
    end)
end

U.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        if dg and not mv then
            op = not op
            if op then
                showMenu(mn, MN_H)
            else
                hideMenu(mn, MN_H)
            end
            hideMenu(pl_mn, PL_H)
        end
        dg = false
        sm2 = nil
    end
end)

