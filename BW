local function sf()
    if fc then fc:Disconnect() fc = nil end
    if bv then bv:Destroy() end
    if bg then bg:Destroy() end
    local c = pl.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
    end
end

local function bf()
    local c = pl.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end
    h.PlatformStand = true
    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    bv.Parent = r
    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P = 1e4
    bg.CFrame = r.CFrame
    bg.Parent = r
    fc = R.RenderStepped:Connect(function()
        local cm = workspace.CurrentCamera
        if not r.Parent or not cm then
            sf()
            return
        end
        local m = h.MoveDirection
        if m.Magnitude > 0 then
            bv.Velocity = (m + Vector3.new(0, cm.CFrame.LookVector.Y, 0)).Unit * sd
        else
            bv.Velocity = Vector3.zero
        end
        bg.CFrame = cm.CFrame
    end)
end

local function sw()
    if wc then wc:Disconnect() wc = nil end
    local c = pl.Character
    if c then
        for _, v in pairs(c:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = true end
        end
    end
end

local function bw()
    wc = R.Stepped:Connect(function()
        local c = pl.Character
        if c then
            for _, v in pairs(c:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
end

local function be()
    for _, p in pairs(P:GetPlayers()) do
        if p ~= pl then
            local f = function()
                local c = p.Character
                if c and not c:FindFirstChild("BWESP") then
                    local h = Instance.new("Highlight")
                    h.Name = "BWESP"
                    h.FillColor = Color3.fromRGB(255, 0, 0)
                    h.Parent = c
                end
            end
            if p.Character then f() end
            ec[p] = p.CharacterAdded:Connect(f)
        end
    end
end

local function bn()
