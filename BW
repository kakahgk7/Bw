local function se()
    for _, c2 in pairs(ec) do
        c2:Disconnect()
    end
    ec = {}
    for _, p in pairs(P:GetPlayers()) do
        if p.Character then
            local h = p.Character:FindFirstChild("BWESP")
            if h then h:Destroy() end
            local h2 = p.Character:FindFirstChild("BWNAME")
            if h2 then h2:Destroy() end
            local h3 = p.Character:FindFirstChild("BWUNAME")
            if h3 then h3:Destroy() end
        end
    end
end

local function refresh_pl()
    for _, child in pairs(pl_sc:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, p in pairs(P:GetPlayers()) do
        if p ~= pl then
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(0, 95, 0, 20)
            b.BackgroundColor3 = (p == sel_pl) and Color3.fromRGB(45, 80, 45) or Color3.fromRGB(50, 50, 70)
            b.BorderSizePixel = 0
            b.Text = p.Name
            b.TextColor3 = Color3.fromRGB(255, 255, 255)
            b.Font = Enum.Font.SourceSansBold
            b.TextSize = 11
            b.Parent = pl_sc
            rc(b, 8)
            b.MouseButton1Click:Connect(function()
                sel_pl = p
                refresh_pl()
            end)
        end
    end
end

local function tp_to()
    if not sel_pl then return end
    local c = pl.Character
    if not c then return end
    local r = c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    local tc = sel_pl.Character
    if not tc then return end
    local tr = tc:FindFirstChild("HumanoidRootPart")
    if not tr then return end
    r.CFrame = tr.CFrame * CFrame.new(0, 0, 3)
end

