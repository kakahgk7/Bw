local ms_speeds = {16, 50, 100, 250, 500}
local ms_idx = 1

msb.MouseButton1Click:Connect(function()
    ms_idx = ms_idx % #ms_speeds + 1
    local speed = ms_speeds[ms_idx]
    msb.Text = "移速: " .. speed
    if speed ~= 16 then
        msb.BackgroundColor3 = Color3.fromRGB(45, 80, 45)
        if ms_conn then ms_conn:Disconnect() end
        ms_conn = R.Heartbeat:Connect(function()
            local c = pl.Character
            if c then
                local h = c:FindFirstChildOfClass("Humanoid")
                if h then h.WalkSpeed = speed end
            end
        end)
    else
        msb.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
        if ms_conn then ms_conn:Disconnect() ms_conn = nil end
        local c = pl.Character
        if c then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then h.WalkSpeed = 16 end
        end
    end
end)

